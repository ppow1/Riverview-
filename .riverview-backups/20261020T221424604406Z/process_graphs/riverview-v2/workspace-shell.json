    },
    {
      "from": "rv:riverview-v2:workspace-shell:verify-password",
      "to": "rv:riverview-v2:workspace-shell:issue-session",
      "type": "runtime_transition",
      "label": "Hash matches and Origin/CSRF checks pass"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:verify-password",
      "to": "rv:riverview-v2:workspace-shell:reject-login-csrf",
      "type": "diagnostic_branch",
      "label": "Origin mismatches or one-use CSRF token is invalid"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:reject-login-csrf",
      "to": "rv:riverview-v2:workspace-shell:password-form",
      "type": "recovery_route",
      "label": "Reload login page for a fresh token; retain strict Host check"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:issue-session",
      "to": "rv:riverview-v2:workspace-shell:render-fixtures",
      "type": "runtime_transition"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:verify-password",
      "to": "rv:riverview-v2:workspace-shell:rate-limited",
      "type": "diagnostic_branch",
      "label": "Bad password; fifth failure in 15 minutes"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:rate-limited",
      "to": "rv:riverview-v2:workspace-shell:password-form",
      "type": "recovery_route",
      "label": "Wait Retry-After before trying again"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:render-fixtures",
      "to": "rv:riverview-v2:workspace-shell:restart-preview",
      "type": "recovery_route",
      "label": "Restart invalidates signed cookies and in-memory lockout"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:choose-view",
      "to": "rv:riverview-v2:workspace-shell:choose-presentation",
      "type": "runtime_transition",
      "label": "Change appearance or sidebar layout"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:choose-presentation",
      "to": "rv:riverview-v2:workspace-shell:apply-theme",
      "type": "runtime_transition",
      "label": "Light, Dark, or System selection"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:apply-theme",
      "to": "rv:riverview-v2:workspace-shell:choose-presentation",
      "type": "runtime_transition",
      "label": "Preference survives reload; system follows OS preference"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:choose-presentation",
      "to": "rv:riverview-v2:workspace-shell:cycle-sidebars",
      "type": "runtime_transition",
      "label": "Cycle either sidebar without changing the other"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:cycle-sidebars",
      "to": "rv:riverview-v2:workspace-shell:restore-sidebars",
      "type": "runtime_transition",
      "label": "Hidden state exposes a keyboard-accessible restore button"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:restore-sidebars",
      "to": "rv:riverview-v2:workspace-shell:choose-presentation",
      "type": "runtime_transition"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:choose-presentation",
      "to": "rv:riverview-v2:workspace-shell:integration-unavailable",
      "type": "runtime_transition",
      "label": "Live chat remains disconnected in this preview"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:choose-presentation",
      "to": "rv:riverview-v2:workspace-shell:snapshot-click",
      "type": "runtime_transition",
      "label": "User requests a V2-specific local ZIP"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-click",
      "to": "rv:riverview-v2:workspace-shell:snapshot-capture",
      "type": "runtime_transition"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-capture",
      "to": "rv:riverview-v2:workspace-shell:snapshot-manifest",
      "type": "runtime_transition",
      "label": "Allowlisted state is captured in memory"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-capture",
      "to": "rv:riverview-v2:workspace-shell:snapshot-failure",
      "type": "diagnostic_branch",
      "label": "State capture or hashing fails"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-manifest",
      "to": "rv:riverview-v2:workspace-shell:snapshot-failure",
      "type": "diagnostic_branch",
      "label": "Package exceeds the hard bound"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-download",
      "to": "rv:riverview-v2:workspace-shell:snapshot-verify",
      "type": "verification",
      "label": "Chrome ZIP contents match selected view and hashes"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-verify",
      "to": "rv:riverview-v2:workspace-shell:choose-presentation",
      "type": "runtime_transition"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-failure",
      "to": "rv:riverview-v2:workspace-shell:choose-presentation",
      "type": "recovery_route",
      "label": "Retry locally; no upload or service recovery is needed"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-manifest",
      "to": "rv:riverview-v2:workspace-shell:snapshot-archive",
      "type": "runtime_transition"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:snapshot-archive",
      "to": "rv:riverview-v2:workspace-shell:snapshot-download",
