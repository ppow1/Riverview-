      "from": "rv:riverview-v2:workspace-shell:check-session",
      "to": "rv:riverview-v2:workspace-shell:render-fixtures",
      "type": "runtime_transition",
      "label": "Valid signed cookie"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:check-session",
      "to": "rv:riverview-v2:workspace-shell:password-form",
      "type": "diagnostic_branch",
      "label": "No valid session"
    },
    {
      "from": "rv:riverview-v2:workspace-shell:password-form",
      "to": "rv:riverview-v2:workspace-shell:verify-password",
      "type": "runtime_transition",
