      "to": "rv:worker-adapter:deterministic-attempt:single-use-disposition-denied",
      "type": "diagnostic_branch",
      "label": "Grant, exact assignment, contract digest, history, lease, or no-effect check fails"
    },
    {
      "from": "rv:worker-adapter:deterministic-attempt:single-use-disposition-check",
      "to": "rv:worker-adapter:deterministic-attempt:single-use-disposition-audit",
      "type": "verification",
      "label": "Every disposition predicate passes"
    },
    {
      "from": "rv:worker-adapter:deterministic-attempt:single-use-disposition-audit",
      "to": "rv:worker-adapter:deterministic-attempt:single-use-disposition-ready",
      "type": "runtime_transition",
      "label": "Append audit and transition atomically"
    },
    {
      "from": "rv:worker-adapter:deterministic-attempt:single-use-disposition-ready",
      "to": "rv:worker-adapter:deterministic-attempt:claim",
      "type": "recovery_route",
      "label": "Normal claim repeats worker capability, scope, lease, and assignment.execute checks"
    }
  ]
}
