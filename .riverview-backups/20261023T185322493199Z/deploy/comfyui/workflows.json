{
  "sd-turbo-text-to-image.v1": {
    "revision": "sd-turbo-1step-512-v1",
    "workflow": {
      "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd_turbo.safetensors"}},
      "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "A small red cabin beside a quiet lake at sunrise, clean illustrative style", "clip": ["4", 1]}},
      "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
      "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 512, "height": 512, "batch_size": 1}},
      "3": {"class_type": "KSampler", "inputs": {"seed": 7, "steps": 1, "cfg": 1.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}},
      "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
      "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "riverview-comfyui", "images": ["8", 0]}}
    },
    "bindings": {
      "prompt": {"node": "6", "input": "text", "type": "text", "max_length": 500},
      "seed": {"node": "3", "input": "seed", "type": "integer", "min": 0, "max": 999999999}
    },
    "output_nodes": ["9"]
  }
}
