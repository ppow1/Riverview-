      "from": "rv:resident-reasoning:runtime:exchange-mcp-auth",
      "to": "rv:resident-reasoning:runtime:exchange-mcp-initialize",
      "type": "prerequisite",
      "label": "valid bearer maps to registered provider principal and scope"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-mcp-auth",
      "to": "rv:resident-reasoning:runtime:exchange-mcp-auth-denied",
      "type": "diagnostic_branch",
      "label": "credential missing, expired, unmapped or scope denied"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-mcp-auth-denied",
      "to": "rv:resident-reasoning:runtime:exchange-transport-blocked",
      "type": "recovery_route",
      "label": "preserve exchange state; retry only after credential correction"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-mcp-initialize",
      "to": "rv:resident-reasoning:runtime:exchange-mcp-tools",
      "type": "runtime_transition",
      "label": "MCP protocol initialization succeeds"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-mcp-tools",
      "to": "rv:resident-reasoning:runtime:exchange-mcp-pull",
      "type": "runtime_transition",
      "label": "client discovers and calls provider request retrieval"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-mcp-pull",
      "to": "rv:resident-reasoning:runtime:exchange-delivery-lease",
      "type": "runtime_transition",
      "label": "selected provider receives bounded request through existing delivery lease"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-external-claim",
      "to": "rv:resident-reasoning:runtime:exchange-response-gate",
      "type": "runtime_transition",
      "label": "MCP submit tool supplies structured advisory and claim fence"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-response-persisted",
      "to": "rv:resident-reasoning:runtime:exchange-mcp-status",
      "type": "runtime_transition",
      "label": "provider may inspect body-free persisted outcome"
    },
    {
      "from": "rv:resident-reasoning:runtime:exchange-mcp-status",
      "to": "rv:resident-reasoning:runtime:exchange-grace-consumption",
      "type": "runtime_transition",
      "label": "status is observational; Grace consumes only through its existing authorized workflow"
    }
  ]
}
