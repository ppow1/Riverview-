# Riverview~ controlled configuration example
# File Revision: 1.0.4
# Changed: 2026-10-11 UTC | RV-M4.4-ENV-TEMPLATE-REVISION | Add revision header recognized by controlled-file audit
# Changed: 2026-10-13 UTC | RV-CODEX-SUBSCRIPTION-SUPERVISOR-001 | Document API-free supervised ChatGPT session settings
# Changed: 2026-10-15 UTC | RV-GRACE-DEMO-PROVISIONER-001 | Document bound router opt-in and approved model identities
# Copy to root-owned /etc/riverview/grace-execution.env with mode 0640.
# Values identify exact pre-provisioned residents/grants; this file contains no credentials.
RIVERVIEW_WORKER_ID=worker:grace-engineering
RIVERVIEW_WORKER_SCOPE=work-order:engineering
RIVERVIEW_VERIFIER_ID=verifier:grace-engineering
RIVERVIEW_RESIDENT_OFFICE_ID=office:grace
RIVERVIEW_KNOWLEDGE_COMMIT=replace-with-approved-full-lowercase-commit-id
# Current Camrui Grace provider. These values bind the 0.6B autonomic fallback and
# approved 30B/80B services to the already-bound readiness router.
RIVERVIEW_REASONING_ENDPOINT=http://127.0.0.1:18796/v1
RIVERVIEW_REASONING_MODEL=qwen3-0.6b-q8_0-local
RIVERVIEW_REASONING_MODEL_SHA256=9465e63a22add5354d9bb4b99e90117043c7124007664907259bd16d043bb031
RIVERVIEW_GRACE_ENABLE_MODEL_ROUTER=1
RIVERVIEW_GRACE_ALLOW_APPROVED_OCTO1=1
RIVERVIEW_GRACE_30B_MODEL_SHA256=52805ade47b36f2151df1fde46779c27cb45ed64057cca099499f6336ae2be47
RIVERVIEW_GRACE_80B_MODEL_SHA256=d103b2733ec1012a52d01edda66b7e5c24ae50508c9f99f5297ea459ef3c061a
RIVERVIEW_RESIDENT_REASONING_TIMEOUT=25
RIVERVIEW_RESIDENT_REASONING_TOKENS=256
# Codex execution uses the existing ChatGPT sign-in in place, never an API key.
RIVERVIEW_CODEX_AUTH_MODE=chatgpt-owner-session
RIVERVIEW_ENGINEERING_ADAPTER=codex-cli
RIVERVIEW_CODEX_EXECUTABLE=/opt/riverview-codex/bin/codex
RIVERVIEW_CODEX_TIMEOUT_SECONDS=180
# The installer/provisioner supplies and verifies the pinned repository path/ref,
# source commit, owner-session workspace paths, and protected runtime credentials.
