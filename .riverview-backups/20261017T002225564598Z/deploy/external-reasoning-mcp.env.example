# Riverview~ controlled configuration template
# File Revision: 1.1.0
# Component: EXTERNAL-REASONING-MCP-TRANSPORT
# Task: RV-EXTERNAL-MCP-ADAPTER-001
# Purpose: Non-secret configuration contract for the loopback OAuth MCP resource server
# Authority: Values do not grant authority; OAuth subject/provider allowlist is a systemd credential

# Canonical MCP resource ID. It must match the access-token audience.
RIVERVIEW_MCP_RESOURCE_URL=https://replace-with-approved-host.example/mcp
# Issuer must publish OAuth/OIDC metadata with authorization-code + PKCE S256.
RIVERVIEW_MCP_AUTHORIZATION_SERVER_URL=https://replace-with-approved-issuer.example/
RIVERVIEW_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
RIVERVIEW_MCP_ALLOWED_ORIGINS=
