    },
    {
      "from": "rv:resident-reasoning:runtime:grace-role-context",
      "to": "rv:resident-reasoning:runtime:provider-call",
      "type": "runtime_transition",
      "label": "Role context is bounded and supplies no permissions"
    },
    {
      "from": "rv:resident-reasoning:runtime:budget-gate",
      "to": "rv:resident-reasoning:runtime:budget-insufficient",
      "type": "diagnostic_branch",
      "label": "total token budget is smaller than route length"
    },
    {
      "from": "rv:resident-reasoning:runtime:select-provider",
      "to": "rv:resident-reasoning:runtime:task-escalation-contract",
      "type": "prerequisite",
