      "from": "rv:resident-reasoning:runtime:select-provider",
      "to": "rv:resident-reasoning:runtime:binding-jump",
      "type": "documentation"
    },
    {
      "from": "rv:resident-reasoning:runtime:binding-jump",
      "to": "rv:institutional-authority:identity-and-grants:office-state",
      "type": "jump"
    },
    {
      "from": "rv:resident-reasoning:runtime:route-gate",
      "to": "rv:resident-reasoning:runtime:route-unavailable",
      "type": "diagnostic_branch",
      "label": "unknown or invalid route"
    },
    {
      "from": "rv:resident-reasoning:runtime:provider-call",
      "to": "rv:resident-reasoning:runtime:fallback-gate",
      "type": "runtime_transition"
    },
    {
      "from": "rv:resident-reasoning:runtime:fallback-gate",
      "to": "rv:resident-reasoning:runtime:proposal-gate",
      "type": "runtime_transition",
      "label": "provider returned"
    },
    {
      "from": "rv:resident-reasoning:runtime:fallback-gate",
      "to": "rv:resident-reasoning:runtime:fallback",
      "type": "recovery_route",
      "label": "timeout/failure with configured next provider"
    },
    {
      "from": "rv:resident-reasoning:runtime:fallback",
      "to": "rv:resident-reasoning:runtime:provider-call",
      "type": "runtime_transition"
    },
    {
      "from": "rv:resident-reasoning:runtime:proposal-gate",
      "to": "rv:resident-reasoning:runtime:freshness-gate",
      "type": "runtime_transition",
      "label": "schema and budget pass"
    },
    {
      "from": "rv:resident-reasoning:runtime:proposal-gate",
      "to": "rv:resident-reasoning:runtime:proposal-invalid",
      "type": "diagnostic_branch",
      "label": "invalid schema or token budget"
    },
    {
      "from": "rv:resident-reasoning:runtime:freshness-gate",
      "to": "rv:resident-reasoning:runtime:persist-plan",
      "type": "runtime_transition",
      "label": "binding and assignment revisions unchanged"
    },
    {
      "from": "rv:resident-reasoning:runtime:freshness-gate",
      "to": "rv:resident-reasoning:runtime:stale-context",
      "type": "diagnostic_branch",
      "label": "revision changed"
    },
    {
      "from": "rv:resident-reasoning:runtime:persist-plan",
      "to": "rv:resident-reasoning:runtime:persistence-gate",
      "type": "runtime_transition"
    },
    {
      "from": "rv:resident-reasoning:runtime:persistence-gate",
      "to": "rv:resident-reasoning:runtime:proposal-only",
      "type": "runtime_transition",
      "label": "durable write committed"
    },
    {
      "from": "rv:resident-reasoning:runtime:persistence-gate",
      "to": "rv:resident-reasoning:runtime:state-conflict",
      "type": "diagnostic_branch",
