{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverview:notification-delivery:api:1.0.1",
  "title": "Riverview visual notification API",
  "oneOf": [
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "page": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "observed_at",
        "limit",
        "dispatcher",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": "rv.notifications.v1"
        },
        "status": {
          "enum": [
            "available",
            "not_initialized"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "dispatcher": {
          "type": "object"
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "push_delivery": {
          "$ref": "#/$defs/pushDelivery"
        }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": [
        "notification_id",
        "source_event_id",
        "assignment_id",
        "event_type",
        "channel",
        "source_recorded_at",
        "created_at",
        "delivered_at",
        "acknowledged_at",
        "request_id",
        "decision_status",
        "assignment_version",
        "delivery_status",
        "decision_request_id",
        "summary"
      ],
      "properties": {
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "source_event_id": {
          "type": "string",
          "format": "uuid"
        },
        "assignment_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "enum": [
            "assignment_stalled",
            "deadline_missed",
            "assignment_attention",
            "recovery_requested",
            "monitor_failed",
            "attention_resolved"
          ]
        },
        "channel": {
          "const": "dashboard.visual.v1"
        },
        "source_recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "delivered_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "acknowledged_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "decision_request_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "decision_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            null
          ]
        },
        "assignment_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "delivery_status": {
          "enum": [
            "queued",
            "delivered",
            "acknowledged"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 160
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "notification_id",
        "recorded_at",
        "already_recorded",
        "decision_request_status",
        "authority_effect"
      ],
      "properties": {
        "schema_version": {
          "const": "rv.notification_receipt.v1"
        },
        "status": {
          "enum": [
            "delivered",
            "acknowledged"
          ]
        },
        "notification_id": {
          "type": "string",
          "format": "uuid"
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "already_recorded": {
          "type": "boolean"
        },
        "decision_request_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "pending",
            null
          ]
        },
        "authority_effect": {
          "const": "none"
        }
      },
      "additionalProperties": false
    },
    "pushDelivery": {
      "type": "object",
      "required": [
        "schema_version",
        "component_id",
        "status",
        "observed_at",
        "freshness",
        "queue",
        "recovery",
        "failure",
        "last_cycle_at",
        "counters",
        "read_only",
        "content_included"
      ],
      "properties": {
        "schema_version": {
          "const": "rv.notification_push_status.v2"
        },
        "component_id": {
          "const": "NOTIFICATION-DELIVERY"
        },
        "status": {
          "enum": [
            "healthy",
            "stale",
            "degraded",
            "not_initialized",
            "unavailable",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "freshness": {
          "type": "object",
          "required": [
            "state",
            "heartbeat_age_seconds",
            "threshold_seconds"
          ],
          "properties": {
            "state": {
              "enum": [
                "fresh",
                "stale",
                "unknown",
                "unavailable"
              ]
            },
            "heartbeat_age_seconds": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "threshold_seconds": {
              "const": 15
            }
          },
          "additionalProperties": false
        },
        "queue": {
          "type": "object",
          "required": [
            "state",
            "by_state",
            "retry_due_count",
            "expired_lease_count"
          ],
          "properties": {
            "state": {
              "enum": [
                "available",
                "not_initialized",
                "unavailable"
              ]
            },
            "by_state": {
              "type": "object",
              "properties": {
                "queued": {
                  "type": "integer",
                  "minimum": 0
                },
                "sending": {
                  "type": "integer",
                  "minimum": 0
                },
                "retry": {
                  "type": "integer",
                  "minimum": 0
                },
                "accepted": {
                  "type": "integer",
                  "minimum": 0
                },
                "acknowledged": {
                  "type": "integer",
                  "minimum": 0
                },
                "expired": {
                  "type": "integer",
                  "minimum": 0
                },
                "failed": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "retry_due_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "expired_lease_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "recovery": {
          "type": "object",
          "required": [
            "state",
            "retry_pending_count",
            "expired_lease_count"
          ],
          "properties": {
            "state": {
              "enum": [
                "idle",
                "retry_pending",
                "lease_recovery_pending",
                "worker_recovery_required",
                "unknown",
                "unavailable"
              ]
            },
            "retry_pending_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "expired_lease_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "failure": {
          "type": "object",
          "required": [
            "state",
            "code"
          ],
          "properties": {
            "state": {
              "enum": [
                "none",
                "recorded",
                "unavailable"
              ]
            },
            "code": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80,
              "pattern": "^[A-Za-z0-9_.-]{1,80}$"
            }
          },
          "additionalProperties": false
        },
        "last_cycle_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "counters": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "notices_scanned": {
              "type": "integer",
              "minimum": 0
            },
            "deliveries_queued": {
              "type": "integer",
              "minimum": 0
            },
            "provider_accepted": {
              "type": "integer",
              "minimum": 0
            },
            "emergency_acknowledged": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "notices_scanned",
            "deliveries_queued",
            "provider_accepted",
            "emergency_acknowledged"
          ],
          "additionalProperties": false
        },
        "read_only": {
          "const": true
        },
        "content_included": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  }
}
