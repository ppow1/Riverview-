    },
    {
      "id": "conversation.send",
      "selector": "#chat-send",
      "action": "Send message to Grace",
      "component": "Grace conversation",
      "mutating": true,
      "authorization": "Existing conversation authority"
    },
    {
      "id": "conversation.newline",
      "selector": "#chat-newline",
