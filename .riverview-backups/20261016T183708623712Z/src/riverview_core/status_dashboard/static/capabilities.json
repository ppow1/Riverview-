{
  "schema_version": "rv.website.capabilities.v1",
  "registry_id": "rv:steward-dashboard:website-capabilities",
  "revision": "1.1.0",
  "purpose": "Describe dashboard pages, controls, data sources, workflow surfaces and diagnostic export representations. A declaration is not evidence of control operation.",
  "pages": [
    {
      "id": "overview",
      "title": "Operations overview",
      "selector": "#view-overview",
      "navigation_selector": "[data-view='overview']",
      "components": [
        "status summary",
        "assignments",
        "CME attention",
        "worker inventory",
        "recent events"
      ],
      "data_sources": [
        "GET /api/v1/status",
        "GET /api/v1/assignments",
        "GET /api/v1/events",
        "GET /api/v1/workers"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    },
    {
      "id": "assignments",
      "title": "Assignments",
      "selector": "#view-assignments",
      "navigation_selector": "[data-view='assignments']",
      "components": [
        "assignment list",
        "assignment detail",
        "attempts",
        "verification",
        "events"
      ],
      "data_sources": [
        "GET /api/v1/assignments",
        "GET /api/v1/assignments/{id}"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    },
    {
      "id": "objectives",
      "title": "Grace objectives",
      "selector": "#view-objectives",
      "navigation_selector": "[data-view='objectives']",
      "components": [
        "objective lifecycle",
        "objective intake guidance"
      ],
      "data_sources": [
        "GET /api/v1/objectives"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    },
    {
      "id": "grace-chat",
      "title": "Talk with Grace",
      "selector": "#view-grace-chat",
      "navigation_selector": "[data-view='grace-chat']",
      "components": [
        "conversation authentication",
        "conversation history",
        "stream status",
        "message composer"
      ],
      "data_sources": [
        "GET /api/v1/resident/conversations",
        "GET /api/v1/resident/conversations/{id}"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ],
      "privacy": "Conversation and request bodies are excluded from exported page captures and diagnostics."
    },
    {
      "id": "activity",
      "title": "Activity",
      "selector": "#view-activity",
      "navigation_selector": "[data-view='activity']",
      "components": [
        "event page",
        "sequence navigation",
        "diagnostic links"
      ],
      "data_sources": [
        "GET /api/v1/events"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    },
    {
      "id": "workflows",
      "title": "Workflows",
      "selector": "#view-workflows",
      "navigation_selector": "[data-view='workflows']",
      "components": [
        "workflow selector",
        "SVG graph canvas",
        "node details",
        "cross-workflow jump points"
      ],
      "data_sources": [
        "GET /api/v1/graphs",
        "GET /api/v1/graphs/{graph_id}"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview",
        "authoritative workflow JSON",
        "separate runtime-status JSON",
        "full-extent workflow SVG",
        "high-resolution workflow PNG overview",
        "readable workflow PNG detail tiles where required"
      ]
    },
    {
      "id": "notifications",
      "title": "Notifications",
      "selector": "#view-notifications",
      "navigation_selector": "[data-view='notifications']",
      "components": [
        "notification list",
        "receipt state",
        "source links"
      ],
      "data_sources": [
        "GET /api/v1/notifications"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    },
    {
      "id": "documentation",
      "title": "Documentation and diagnostics",
      "selector": "#view-documentation",
      "navigation_selector": "[data-view='documentation']",
      "components": [
        "searchable workflow registry",
        "provenance references",
        "documentation links"
      ],
      "data_sources": [
        "GET /api/v1/graphs"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    },
    {
      "id": "account",
      "title": "Account access administration",
      "selector": "#view-account",
      "navigation_selector": "#account-nav",
      "authorization": "Steward account role",
      "components": [
        "enrollments",
        "account/session inventory",
        "email configuration"
      ],
      "data_sources": [
        "GET /api/v1/account/enrollments",
        "GET /api/v1/account/users",
        "GET /api/v1/account/email-settings"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ],
      "privacy": "Account rows, email values and all form values are redacted from exported page captures."
    },
    {
      "id": "resident-permissions",
      "title": "Resident permissions",
      "selector": "#view-resident-permissions",
      "navigation_selector": "#resident-permissions-nav",
      "authorization": "Steward account role and existing server-side authorization",
      "components": [
        "resident permission profiles",
        "profile state and transitions"
      ],
      "data_sources": [
        "GET /api/v1/resident-permissions"
      ],
      "representations": [
        "sanitized offline HTML",
        "full-content SVG layout capture with stable control IDs",
        "PNG page overview"
      ]
    }
  ],
  "controls": [
    {
      "id": "navigation.overview",
      "selector": "[data-view='overview']",
      "action": "Navigate to overview",
      "component": "primary navigation"
    },
    {
      "id": "navigation.assignments",
      "selector": "[data-view='assignments']",
