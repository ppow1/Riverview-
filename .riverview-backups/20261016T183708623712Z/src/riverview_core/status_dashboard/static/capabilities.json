  ],
  "workflow_surfaces": {
    "registry_source": "GET /api/v1/snapshot/workflow-index",
    "definition_source": "GET /api/v1/graphs/{graph_id}",
    "authoritative_repository_path": "process_graphs/*/*.json",
    "storage_classification": "Version-controlled canonical graph JSON; the ledger stores execution references/state, not graph definitions.",
    "representations": [
      "original canonical JSON per workflow",
      "separate runtime-status JSON per workflow",
      "workflow-index.json with cross-workflow jump references",
      "full-extent SVG per workflow",
      "PNG overview per workflow",
      "overlapping PNG detail tiles where needed"
    ]
  },
  "diagnostic_retention": {
    "interactions": 120,
    "requests": 200,
    "errors": 50,
    "request_bodies": "never collected",
    "authentication_material": "never collected",
    "truncation": "Count and report entries dropped at the bounded retention limit.",
    "package_max_uncompressed_bytes": 100663296
  },
  "future_testing_consumer": {
    "supported": true,
    "contract": "Stable registry/page/control IDs and declared actions/data sources are available; this release does not implement automated interaction tests."
  },
  "control_state_vocabulary": [
    "registered",
    "rendered",
    "available",
    "disabled",
    "unavailable",
    "not_observed",
    "uncovered_rendered"
  ],
  "capture_contract": {
    "pages": "Discover from this registry at capture time; visit only pages reachable by current authenticated user permissions.",
    "controls": "Compare registered selectors with controls observed on each captured page. Declarations do not prove action behavior.",
    "page_visuals": "Include sanitized offline HTML and bounded full-content SVG/PNG visual representations; report inaccessible pages or page-size truncation.",
    "workflow_visuals": "Export from each authenticated canonical graph response independent of page viewport, zoom, and scroll position.",
    "workflow_status": "Export the graph API execution_position projection separately from unchanged canonical graph JSON.",
    "offline_review": "Unzip and inspect page HTML, page/control JSON, graph JSON, workflow index, SVG and PNG without network access."
  }
}
