      "component": "primary navigation"
    },
    {
      "id": "navigation.rail-toggle",
      "selector": "#rail-toggle",
      "action": "Collapse or expand navigation rail",
      "component": "primary navigation"
    },
    {
      "id": "navigation.sign-out",
      "selector": "#sign-out",
      "action": "End the current website account session",
      "component": "account authentication",
      "authorization": "Current account session"
    },
    {
      "id": "authentication.recovery",
      "selector": "#auth-open",
      "action": "Open protected legacy recovery connection",
      "component": "account authentication"
    },
    {
      "id": "snapshot.download",
      "selector": "#snapshot",
      "action": "Build and download this bounded offline diagnostic ZIP",
      "component": "diagnostic snapshot"
    },
    {
      "id": "dashboard.refresh",
      "selector": "#refresh",
      "action": "Refresh read-only dashboard projections",
      "component": "overview"
    },
    {
      "id": "assignments.open",
      "selector": "[data-assignment]",
      "action": "Open assignment detail",
      "component": "assignments",
      "data_sources": [
        "GET /api/v1/assignments/{id}"
      ]
    },
    {
      "id": "assignments.next-page",
      "selector": "#more-assignments",
      "action": "Load next assignment page",
      "component": "assignments"
    },
    {
      "id": "workers.next-page",
      "selector": "#more-workers",
      "action": "Load next worker page",
      "component": "overview"
    },
    {
      "id": "events.open-assignment",
      "selector": ".event-card [data-assignment]",
