      "component": "primary navigation"
    },
    {
      "id": "navigation.objectives",
      "selector": "[data-view='objectives']",
      "action": "Navigate to objectives",
      "component": "primary navigation"
    },
    {
      "id": "navigation.grace-chat",
      "selector": "[data-view='grace-chat']",
