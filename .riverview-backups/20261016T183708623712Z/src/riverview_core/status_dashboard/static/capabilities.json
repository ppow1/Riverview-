      "selector": "#view-resident-permissions button,#view-resident-permissions select",
      "action": "Inspect or change resident permission profile",
      "component": "resident permissions",
      "authorization": "Existing server-side authorization",
      "mutating": true
    },
    {
      "id": "dialog.close",
      "selector": "[data-close-dialog]",
      "action": "Close the current detail dialog",
      "component": "dialogs"
    },
    {
