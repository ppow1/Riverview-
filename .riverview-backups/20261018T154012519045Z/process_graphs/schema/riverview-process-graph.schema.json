{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverview:process-graph:1.0.1",
  "title": "Riverview Process Graph",
  "type": "object",
  "required": ["graph_id", "graph_revision", "component_id", "workflow_id", "source_references", "documentation_references", "verification_evidence", "nodes", "edges"],
  "properties": {
    "graph_id": {"type": "string", "pattern": "^rv:[a-z0-9-]+:[a-z0-9-]+$"},
    "graph_revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "component_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
    "workflow_id": {"type": "string", "minLength": 1},
    "diagram_order": {"type": "integer", "minimum": 1},
    "source_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "documentation_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "verification_evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}, "minItems": 1},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}}
  },
  "$defs": {
    "reference": {"type": "string", "minLength": 1},
    "nodeType": {"anyOf": [{"enum": ["process", "entry", "exit", "decision", "measurement", "failure", "recovery", "verification", "jump", "escalation"]}, {"type": "string", "pattern": "^x-[a-z0-9.-]+:[A-Za-z0-9._-]+$"}]},
    "edgeType": {"anyOf": [{"enum": ["runtime_transition", "prerequisite", "diagnostic_branch", "recovery_route", "verification", "jump", "escalation", "documentation"]}, {"type": "string", "pattern": "^x-[a-z0-9.-]+:[A-Za-z0-9._-]+$"}]},
    "node": {
      "type": "object",
      "required": ["id", "node_revision", "type", "label", "source_references", "documentation_references", "verification_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^rv:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"},
        "node_revision": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "type": {"$ref": "#/$defs/nodeType"},
        "label": {"type": "string", "minLength": 1},
        "source_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "documentation_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "verification_evidence": {"type": "array", "items": {"$ref": "#/$defs/reference"}},
        "jump_target_id": {"type": "string", "pattern": "^rv:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"},
        "extension": {"type": "object"}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "jump"}}, "required": ["type"]}, "then": {"required": ["jump_target_id"]}}],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "type"],
      "properties": {
        "from": {"type": "string", "pattern": "^rv:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"},
        "to": {"type": "string", "pattern": "^rv:[a-z0-9-]+:[a-z0-9-]+:[a-z0-9-]+$"},
        "type": {"$ref": "#/$defs/edgeType"},
        "label": {"type": "string"},
        "evidence_reference": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
