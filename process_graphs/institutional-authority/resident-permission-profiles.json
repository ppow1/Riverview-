      "to": "rv:institutional-authority:resident-permission-profiles:migration-ready",
      "type": "verification"
    },
    {
      "from": "rv:institutional-authority:resident-permission-profiles:migration-ready",
      "to": "rv:institutional-authority:resident-permission-profiles:migration-stop",
      "type": "diagnostic_branch",
      "label": "No; retain the existing release and database state"
    },
    {
      "from": "rv:institutional-authority:resident-permission-profiles:migration-ready",
      "to": "rv:institutional-authority:resident-permission-profiles:migration-apply-atomic",
      "type": "runtime_transition",
      "label": "Yes; exact release, checksum and backup gates pass"
    },
    {
      "from": "rv:institutional-authority:resident-permission-profiles:migration-apply-atomic",
      "to": "rv:institutional-authority:resident-permission-profiles:migration-postflight",
      "type": "verification",
      "label": "All changes remain inside the open migration transaction"
    },
    {
      "from": "rv:institutional-authority:resident-permission-profiles:migration-apply-atomic",
      "to": "rv:institutional-authority:resident-permission-profiles:migration-stop",
      "type": "diagnostic_branch",
      "label": "Any DDL, role, grant or postcondition failure"
    },
    {
      "from": "rv:institutional-authority:resident-permission-profiles:migration-stop",
      "to": "rv:institutional-authority:resident-permission-profiles:migration-rollback",
      "type": "recovery_route"
    },
    {
      "from": "rv:institutional-authority:resident-permission-profiles:migration-rollback",
      "to": "rv:institutional-authority:resident-permission-profiles:migration-preflight",
      "type": "runtime_transition",
      "label": "Only after a reviewed correction and fresh preflight"
    }
  ]
}
