 class GraceReasoningFailureDiagnosticTests(unittest.TestCase):
+    def test_artifact_publication_admission_precedes_persistence(self):
+        from types import SimpleNamespace
+        from unittest.mock import Mock
+        from riverview_core.resident_execution.service import GraceExecutionService
+
+        ordinary = "The report contains the exact text: verified."
+        publication = "The report is published in the GitHub repository with a commit SHA."
+        provenance = "The source change uses the pinned repository commit " + "a" * 40
+        cases = (
+            ("step-publication", publication, ordinary, False, True),
+            ("requirement-publication", ordinary, publication, False, True),
+            ("ordinary-artifact", ordinary, ordinary, False, False),
+            ("source-provenance", provenance, ordinary, True, False),
+        )
+
+        class PersistenceReached(Exception):
+            pass
+
+        for name, criterion, artifact_criterion, source, rejected in cases:
+            with self.subTest(name=name):
+                db = Mock()
+                db.transaction.side_effect = PersistenceReached
+                pipeline = object.__new__(GraceExecutionPipeline)
+                pipeline.ledger = SimpleNamespace(db=db)
+                objective = {
+                    "status": "GROUNDED", "revision": 2,
+                    "request": "Create reports/result.txt; update src/example.py and tests/test_example.py in repo://test/repo at " + "a" * 40,
+                    "acceptance_criteria": [criterion],
+                    "evidence": {"status": "VERIFIED", "retrieval_complete": True,
+                        "source_references": ["repo://test/repo"], "source_sha256": "b" * 64},
+                }
+                pipeline.get_objective = lambda _id: objective
+                pipeline.objective_events = lambda _id: []
+                kwargs = ({"execution_capability": "engineering.codex-cli-source-change.v1",
+                    "repository_reference": "repo://test/repo", "repository_revision": "a" * 40,
+                    "authorized_paths": ("src/example.py", "tests/test_example.py"),
+                    "test_targets": ("tests/test_example.py",)} if source else {})
+                proposal = PlanProposal("Create the report", (PlanStep(
+                    "report", "Create the report", (criterion,),
+                    artifact_requirements=(() if source else (ArtifactRequirement(
+                        "report", "reports/result.txt", "text/plain", (artifact_criterion,)),)),
+                    **kwargs),), 0)
+                if rejected:
+                    with self.assertRaises(ObjectiveStateError) as caught:
+                        pipeline.record_proposal("objective:test", proposal)
+                    code = GraceExecutionService._reasoning_failure_detail_code(caught.exception)
+                    self.assertEqual(code, "PROPOSAL_PUBLICATION_CAPABILITY_UNAVAILABLE")
+                    self.assertIn(code, GraceExecutionService.PERSISTED_PROPOSAL_BLOCK_CODES)
+                    db.transaction.assert_not_called()
+                else:
+                    with self.assertRaises(PersistenceReached):
+                        pipeline.record_proposal("objective:test", proposal)
+                    db.transaction.assert_called_once_with()
+
