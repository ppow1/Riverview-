+                {"plans": {}, ResidentReasoner.PLAN_ARCHIVE_FIELD: None}):
+            with self.subTest(invalid=type(invalid[ResidentReasoner.PLAN_ARCHIVE_FIELD]).__name__):
+                with self.assertRaises(PlanArchiveInvalid):
+                    ResidentReasoner._decode_plan_cache(invalid)
+        import base64, hashlib, zlib
+        raw = b"x" * (ResidentReasoner.MAX_PLAN_ARCHIVE_RAW_BYTES + 4096)
+        bomb = {"version": 1, "encoding": "zlib+base64-json-v1",
+                "sha256": hashlib.sha256(raw).hexdigest(),
+                "data": base64.b64encode(zlib.compress(raw)).decode("ascii")}
+        with self.assertRaises(PlanArchiveInvalid):
+            ResidentReasoner._decode_plan_cache({
+                "plans": {}, ResidentReasoner.PLAN_ARCHIVE_FIELD: bomb})
