+# =============================================================================
+# RIVERVIEW~ CONTROLLED TEST
+# File: tests/test_resident_plan_archive.py
+# Component: RESIDENT-REASONING
+# Revision: 1.0.0
+# Purpose: Verify lossless bounded office plan archival and rollback compatibility.
+# Authority: Offline only; fake registry and no PostgreSQL or provider calls.
+# =============================================================================
+import json
+import unittest
+
+from riverview_core.resident_reasoning import (
+    PlanArchiveInvalid, PlanProposal, PlanStep, ResidentReasoner,
+)
+
+
+def compact(value):
+    return json.dumps(value, ensure_ascii=False, sort_keys=True,
+                      separators=(",", ":"), allow_nan=False).encode("utf-8")
+
+
+def proposal(summary):
+    return PlanProposal(summary, (PlanStep(
+        "step", "retain a bounded plan", ("plan is replayable",)),), 1)
+
+
+def sized_plans(target_bytes):
+    plans = {f"assignment:{i:02d}": __import__("dataclasses").asdict(
+        proposal("p" * 2000)) for i in range(24)}
+    key = "assignment:24"
+    low, high = 1, 4000
+    while low <= high:
+        mid = (low + high) // 2
+        plans[key] = __import__("dataclasses").asdict(proposal("p" * mid))
+        size = len(compact(plans))
+        if size == target_bytes:
+            return plans
+        if size < target_bytes:
+            low = mid + 1
+        else:
+            high = mid - 1
+    raise AssertionError("could not construct exact synthetic plan-cache size")
+
+
+class _Registry:
+    def __init__(self):
+        self.state = None
+        self.writes = 0
+
+    def set_office_state(self, _credential, _office, state, *, expected_revision):
+        self.state = json.loads(json.dumps(state, ensure_ascii=False))
+        self.writes += 1
+        return expected_revision + 1
+
+
+class ResidentPlanArchiveTests(unittest.TestCase):
+    def test_reconstructed_reasoner_replays_archived_prior_plan_to_provider(self):
+        from riverview_core.worker_adapter.knowledge import KnowledgeResult, KnowledgeStatus
+
+        previous = {"assignment:target": {"summary": "prior-plan",
+                                           "steps": [{"id": "prior-step"}]},
+                    "assignment:other": {"summary": "other-plan"}}
+        runtime = ResidentReasoner._encode_plan_cache(previous, "assignment:other")
+        durable_state = {ResidentReasoner.STATE_KEY:
+                         json.loads(json.dumps(runtime, ensure_ascii=False))}
+
+        class Registry(_Registry):
+            revision = 3
+            def authorize_office_state(self, _credential, _office):
+                return {"state_revision": self.revision, "state": self.state,
+                        "occupant_id": "occupant:test", "provider_ref": "provider:test",
+                        "binding_revision": 1, "implementation_revision": "impl:test"}
+
+        class Assignments:
+            def read(self, assignment_id):
+                return {"id": assignment_id, "revision": "7",
+                        "acceptance_criteria": ["retain the prior plan"]}
+
+        class Knowledge:
+            @staticmethod
+            def verified():
+                return KnowledgeResult(KnowledgeStatus.VERIFIED, {"evidence": "verified"},
+                    ("repo://docs/evidence.md",), "revision:test", "a" * 64, True)
+            def ground_assignment(self, _assignment): return self.verified()
+            def reground_assignment(self, _assignment, _trigger): return self.verified()
+
+        class Provider:
+            provider_id = "provider:test"
+            def __init__(self): self.request = None
+            def propose(self, request):
+                self.request = request
+                return proposal("replacement")
+
+        registry = Registry()
+        registry.state = durable_state
+        provider = Provider()
+        reasoner = ResidentReasoner(registry=registry, office_id="office:test",
+            resident_credential="test-credential", assignments=Assignments(),
+            knowledge=Knowledge(), providers={"provider:test": provider}, timeout_seconds=1)
+        result = reasoner.propose("assignment:target", trigger="replay", token_budget=12)
+        self.assertEqual(result.status.value, "PROPOSED")
+        self.assertEqual(provider.request.prior_plan, previous["assignment:target"])
+
+    def test_legacy_raw_cache_read_compatibility(self):
+        old = {"assignment:1": {"summary": "old"}}
+        self.assertEqual(ResidentReasoner._decode_plan_cache({"plans": old}), old)
+        self.assertEqual(ResidentReasoner._decode_plan_cache({}), {})
+
+    def test_deterministic_exact_roundtrip_replay(self):
+        plans = {"assignment:a": {"summary": "alpha"},
+                 "assignment:b": {"summary": "beta"}}
+        encoded1 = ResidentReasoner._encode_plan_cache(plans, "assignment:b")
+        encoded2 = ResidentReasoner._encode_plan_cache(plans, "assignment:b")
+        self.assertEqual(encoded1, encoded2)
+        self.assertEqual(encoded1["plans"], {"assignment:b": plans["assignment:b"]})
+        self.assertEqual(ResidentReasoner._decode_plan_cache(encoded1), plans)
+        self.assertEqual(ResidentReasoner._decode_plan_cache(encoded1)["assignment:a"],
+                         plans["assignment:a"])
+
+    def test_append_and_update_preserve_all_assignment_keys(self):
+        original = {"assignment:a": {"summary": "a"},
+                    "assignment:b": {"summary": "old b"}}
+        updated = ResidentReasoner._decode_plan_cache(
+            ResidentReasoner._encode_plan_cache(original, "assignment:b"))
+        updated["assignment:b"] = {"summary": "new b"}
+        updated["assignment:c"] = {"summary": "c"}
+        stored = ResidentReasoner._encode_plan_cache(updated, "assignment:c")
+        self.assertEqual(ResidentReasoner._decode_plan_cache(stored), updated)
+        archive_only = {ResidentReasoner.PLAN_ARCHIVE_FIELD:
+                        stored[ResidentReasoner.PLAN_ARCHIVE_FIELD]}
+        self.assertFalse(set(stored["plans"]) &
+                         set(ResidentReasoner._decode_plan_cache(archive_only)))
+
+    def test_25_plan_observed_size_fixture_compresses_without_eviction(self):
+        plans = sized_plans(62844)
+        self.assertEqual(len(compact(plans)), 62844)
+        self.assertEqual(len(plans), 25)
+        outcomes = [{"detail_code": "prior", "history": "o" * 1480}]
+        self.assertGreater(len(compact(outcomes)), 1500)
+        encoded = ResidentReasoner._encode_plan_cache(plans, "assignment:24")
+        state = {ResidentReasoner.STATE_KEY: {
+            **encoded, "outcomes": outcomes}}
+        self.assertLess(len(compact(state)), ResidentReasoner.MAX_STATE_BYTES)
+        self.assertLess(len(json.dumps(state, sort_keys=True,
+                         separators=(", ", ": ")).encode()), ResidentReasoner.MAX_STATE_BYTES)
+        expected = json.loads(json.dumps(plans, ensure_ascii=False))
+        encoded_as_jsonb = json.loads(json.dumps(encoded, ensure_ascii=False))
+        self.assertEqual(ResidentReasoner._decode_plan_cache(encoded_as_jsonb), expected)
+        self.assertEqual(state[ResidentReasoner.STATE_KEY]["outcomes"], outcomes)
+        self.assertEqual(len(encoded["plans"]), 1)
+        self.assertEqual(len(ResidentReasoner._decode_plan_cache(encoded)), 25)
+
+    def test_persist_archive_append_keeps_plans_and_existing_outcomes(self):
+        registry = _Registry()
+        reasoner = object.__new__(ResidentReasoner)
+        reasoner.registry = registry
+        reasoner._credential = "test-credential"
+        reasoner.office_id = "office:test"
+        plans = sized_plans(62844)
+        outcomes = [{"detail_code": "prior", "history": "o" * 1480}]
+        snapshot = {"state_revision": 7, "state": {ResidentReasoner.STATE_KEY: {
+            "plans": plans, "outcomes": outcomes}}}
+        result = reasoner._persist(snapshot, assignment_id="assignment:24",
+            observation={"request_id": "new", "status": "PROPOSED"},
+            proposal=proposal("p" * len(plans["assignment:24"]["summary"])))
+        self.assertEqual(result, 8)
+        self.assertEqual(registry.writes, 1)
+        runtime = registry.state[ResidentReasoner.STATE_KEY]
+        restored = ResidentReasoner._decode_plan_cache(runtime)
+        self.assertEqual(set(restored), set(plans))
+        self.assertEqual(restored["assignment:24"]["summary"],
+                         "p" * len(plans["assignment:24"]["summary"]))
+        self.assertEqual([item.get("detail_code") for item in runtime["outcomes"]],
+                         ["prior", None])
+        self.assertLess(len(compact(registry.state)), ResidentReasoner.MAX_STATE_BYTES)
+
+    def test_old_runtime_write_roundtrip_preserves_archive_bytes(self):
+        plans = {"assignment:old": {"summary": "older"},
+                 "assignment:current": {"summary": "current"}}
+        encoded = ResidentReasoner._encode_plan_cache(plans, "assignment:current")
