+
+    def test_legacy_update_wins_overlap_with_archived_assignment(self):
+        original = {"assignment:a": {"summary": "a"},
+                    "assignment:b": {"summary": "old b"},
+                    "assignment:c": {"summary": "c"}}
+        old_runtime = ResidentReasoner._encode_plan_cache(original, "assignment:a")
+        # A rollback runtime only knows `plans`; it can update an assignment
+        # that the newer runtime had placed in the opaque archive.
+        old_runtime["plans"]["assignment:b"] = {"summary": "updated by old runtime"}
+        restored = ResidentReasoner._decode_plan_cache(old_runtime)
+        self.assertEqual(restored["assignment:b"],
+                         {"summary": "updated by old runtime"})
+        self.assertEqual(set(restored), set(original))
+        reencoded = ResidentReasoner._encode_plan_cache(restored, "assignment:b")
+        self.assertEqual(ResidentReasoner._decode_plan_cache(reencoded), restored)
+
+    def test_merged_decode_bound_is_checked_before_registry_write(self):
+        registry = _Registry()
+        reasoner = object.__new__(ResidentReasoner)
+        reasoner.registry = registry
+        reasoner._credential = "test-credential"
+        reasoner.office_id = "office:test"
+        plans = {"assignment:archived": {"summary": "x" * 250_000}}
+        self.assertLess(len(compact(plans)), ResidentReasoner.MAX_PLAN_ARCHIVE_RAW_BYTES)
+        current = {**plans, "assignment:new": {"summary": "y" * 20_000}}
+        self.assertGreater(len(compact(current)), ResidentReasoner.MAX_PLAN_ARCHIVE_RAW_BYTES)
+        large_proposal = PlanProposal("candidate", tuple(PlanStep(
+            f"step-{i}", "y" * 1000, ("criterion" * 50,)) for i in range(20)), 1)
+        result = reasoner._persist(
+            {"state_revision": 3, "state": {ResidentReasoner.STATE_KEY:
+                {"plans": plans}}}, assignment_id="assignment:new",
+            observation={"request_id": "new", "status": "PROPOSED"},
+            proposal=large_proposal)
+        self.assertEqual(result, "OFFICE_STATE_PLAN_ARCHIVE_INVALID")
+        self.assertEqual(registry.writes, 0)
+
