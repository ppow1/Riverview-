 class GraceReasoningFailureDiagnosticTests(unittest.TestCase):
+    def test_publication_required_artifact_plan_is_rejected_with_fixed_diagnostic(self):
+        from riverview_core.resident_execution.pipeline import (
+            GraceExecutionPipeline, ObjectiveStateError, _validate_artifact_publication_capability,
+        )
+        from riverview_core.resident_execution.service import GraceExecutionService
+        from riverview_core.resident_reasoning import ArtifactRequirement, PlanProposal, PlanStep
+
+        publish = "The repository commit is published to GitHub and its remote content is verified."
+        proposal = PlanProposal("Prepare implementation", (
+            PlanStep("implementation", "Create a patch artifact", (publish,)),), 0)
+        with self.assertRaisesRegex(ObjectiveStateError,
+                "repository publication cannot be verified by the registered artifact capability"):
+            _validate_artifact_publication_capability(proposal.steps)
+        pipeline = object.__new__(GraceExecutionPipeline)
+        pipeline.get_objective = lambda _objective_id: self.fail(
+            "rejected publication plan must stop before objective lookup or persistence")
+        with self.assertRaises(ObjectiveStateError):
+            pipeline.record_proposal("objective:offline-publication:r1", proposal)
+        self.assertEqual(GraceExecutionService._reasoning_failure_detail_code(
+            ObjectiveStateError("repository publication cannot be verified by the registered artifact capability; "
+                "require a publication-capable workflow before proposing")),
+            "PROPOSAL_PUBLICATION_CAPABILITY_UNAVAILABLE")
+        self.assertIn("PROPOSAL_PUBLICATION_CAPABILITY_UNAVAILABLE",
+                      GraceExecutionService.PERSISTED_PROPOSAL_BLOCK_CODES)
+
+        artifact_contract = PlanProposal("Prepare evidence", (
+            PlanStep("evidence", "Write a bounded artifact", ("The artifact is valid.",),
+                artifact_requirements=(ArtifactRequirement("report", "report.md",
+                    "text/markdown", (publish,)),)),), 0)
+        with self.assertRaises(ObjectiveStateError):
+            _validate_artifact_publication_capability(artifact_contract.steps)
+        with self.assertRaises(ObjectiveStateError):
+            pipeline.record_proposal("objective:offline-artifact-contract:r1", artifact_contract)
+
