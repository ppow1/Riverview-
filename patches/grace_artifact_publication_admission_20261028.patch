 class ObjectiveStateError(ObjectiveError):
     """The requested lifecycle transition is invalid or its evidence incomplete."""
+
+
+def _validate_artifact_publication_capability(steps):
+    """Reject artifact-capability plans requiring unsupported repository publication."""
+    from .codex_workflow import CodexArtifactVerifier
+
+    for step in steps:
+        if step.execution_capability != "engineering.codex-cli-artifact.v1":
+            continue
+        contract = [asdict(requirement) for requirement in step.artifact_requirements]
+        if CodexArtifactVerifier._publication_required(contract, step.acceptance_criteria):
+            raise ObjectiveStateError(
+                "repository publication cannot be verified by the registered artifact capability; "
+                "require a publication-capable workflow before proposing")
 
 
