+def _explicit_assignment_artifact_paths(assignment):
+    """Return exact safe file paths named in the approved objective/criteria."""
+    if not isinstance(assignment, dict):
+        return ()
+    source = [assignment.get("objective", "")]
+    criteria = assignment.get("acceptance_criteria", ())
+    if (assignment.get("acceptance_criteria_source") != "grace_derived" and
+            isinstance(criteria, (list, tuple))):
+        source.extend(criteria)
+    path_pattern = re.compile(
+        r"(?<![A-Za-z0-9._/-])((?:[A-Za-z0-9][A-Za-z0-9._-]*/)+"
+        r"[A-Za-z0-9][A-Za-z0-9._-]*\.[A-Za-z0-9]{1,12})"
+        r"(?![A-Za-z0-9._/-])")
+    paths = []
+    for value in source:
+        if isinstance(value, str):
+            for path in path_pattern.findall(value):
+                if path not in paths:
+                    paths.append(path)
+    return tuple(paths)
+
