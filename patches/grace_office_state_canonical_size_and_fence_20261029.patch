+# RIVERVIEW~ CONTROLLED TEST
+# File: tests/test_resident_reasoning_office_state_compaction.py
+# Revision: 1.1.0 | 2026-10-29
+"""Offline tests for authority-canonical office-state sizing without eviction."""
+from __future__ import annotations
+
+import copy
+import json
+import unittest
+from hashlib import sha256
+
+from riverview_core.resident_reasoning import (
+    PlanProposal, PlanStep, ReasoningStatus, ResidentReasoner,
+)
+
+OFFICE = "office:canonical-size-test"
+ASSIGNMENT = "objective:canonical-current"
+IMPLEMENTATION = sha256(b"resident canonical-size test").hexdigest()
+
+
+def canonical_bytes(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
+
+
+class FakeRegistry:
+    def __init__(self, state):
+        self.state = copy.deepcopy(state)
+        self.revision = 1
+        self.writes = 0
+
+    def authorize_office_state(self, _credential, office_id):
+        assert office_id == OFFICE
+        return {"occupant_id": "grace-test", "provider_ref": "provider.test",
+                "implementation_revision": IMPLEMENTATION, "binding_revision": 7,
+                "state": copy.deepcopy(self.state), "state_revision": self.revision}
+
+    def set_office_state(self, _credential, office_id, state, *, expected_revision=None):
+        assert office_id == OFFICE and expected_revision == self.revision
+        if len(canonical_bytes(state)) > ResidentReasoner.MAX_STATE_BYTES:
+            raise AssertionError("candidate attempted an over-limit canonical write")
+        self.state = copy.deepcopy(state)
+        self.revision += 1
+        self.writes += 1
+        return self.revision
+
+
+class Assignments:
+    def read(self, assignment_id):
+        return {"id": assignment_id, "revision": "2", "state": "grounded",
+                "workflow_stage": "planning", "acceptance_criteria": ["produce a test plan"]}
+
+
+class Knowledge:
+    def _result(self):
+        from riverview_core.worker_adapter.knowledge import KnowledgeResult, KnowledgeStatus
+        return KnowledgeResult(KnowledgeStatus.VERIFIED, {"rule": "bounded"},
+            ("repo://docs/architecture/CORE_CONTRACT.md",), "1", "a" * 64, True)
+
+    def ground_assignment(self, _assignment): return self._result()
+    def reground_assignment(self, _assignment, _trigger): return self._result()
+
+
+class Provider:
+    provider_id = "provider.test"
+
+    def __init__(self): self.requests = []
+
+    def propose(self, request):
+        self.requests.append(request)
+        return PlanProposal(f"plan {len(self.requests)}",
+            (PlanStep("step", "write test plan", ("produce a test plan",)),), 10)
+
+
+def reasoner(registry, provider):
+    return ResidentReasoner(registry=registry, office_id=OFFICE, resident_credential="test-only",
+        assignments=Assignments(), knowledge=Knowledge(), providers={"provider.test": provider},
+        timeout_seconds=1)
+
+
+class OfficeStateCanonicalSizeTests(unittest.TestCase):
+    def test_canonical_size_fits_while_prior_spaced_encoding_exceeds_without_eviction(self):
+        from dataclasses import asdict
+        prior_plans = {f"objective:prior:{i}": {"summary": f"prior-{i}"}
+                       for i in range(24)}
+        prior_outcomes = [{"assignment_id": f"objective:history:{i}",
+                           "status": "old", "marker": f"history-{i}"}
+                          for i in range(5)]
+        initial = {"resident_reasoning_v1": {"plans": prior_plans,
+                                             "outcomes": prior_outcomes}}
+        # Use a bounded opaque payload to put the final write inside the exact
+        # compact-JSON limit while the old spaced encoding remains over the cap.
+        provider = Provider()
+        registry = FakeRegistry(initial)
+        r = reasoner(registry, provider)
+        snapshot = registry.authorize_office_state("test-only", OFFICE)
+        proposal = PlanProposal("current plan",
+            (PlanStep("step", "write plan", ("produce a test plan",)),), 10)
+        observation = {"request_id": "request:stable", "assignment_id": ASSIGNMENT,
+            "status": "proposed", "detail_code": "PROPOSAL_ONLY", "trigger": "test",
+            "grounding": {}, "regrounding": {}, "provider_id": "provider.test",
+            "correlation_id": None, "provider_response_received": True,
+            "external_advisory": None}
+        base_state = copy.deepcopy(snapshot["state"])
+        runtime = base_state[ResidentReasoner.STATE_KEY]
+        expected_final = copy.deepcopy(base_state)
+        expected_runtime = expected_final[ResidentReasoner.STATE_KEY]
+        expected_runtime["outcomes"] = [*prior_outcomes, observation]
+        expected_runtime["plans"][ASSIGNMENT] = asdict(proposal)
+        low, high = 0, 65536
+        chosen = None
+        while low <= high:
+            mid = (low + high) // 2
+            state = copy.deepcopy(expected_final)
+            state["padding"] = "x" * mid
+            compact = len(canonical_bytes(state))
+            spaced = len(json.dumps(state, sort_keys=True,
+                                    separators=(", ", ": ")).encode("utf-8"))
+            if compact <= ResidentReasoner.MAX_STATE_BYTES and spaced > ResidentReasoner.MAX_STATE_BYTES:
+                chosen = (state, compact, spaced)
+                break
+            if compact > ResidentReasoner.MAX_STATE_BYTES:
+                high = mid - 1
+            else:
+                low = mid + 1
+        self.assertIsNotNone(chosen)
+        final_state, compact, spaced = chosen
+        self.assertLessEqual(compact, ResidentReasoner.MAX_STATE_BYTES)
+        self.assertGreater(spaced, ResidentReasoner.MAX_STATE_BYTES)
+        # Exercise the production persistence entry point with that exact state.
+        initial_state = copy.deepcopy(final_state)
+        initial_state[ResidentReasoner.STATE_KEY]["outcomes"] = prior_outcomes
+        initial_state[ResidentReasoner.STATE_KEY]["plans"].pop(ASSIGNMENT, None)
+        registry.state = initial_state
+        snap = registry.authorize_office_state("test-only", OFFICE)
+        result = r._persist(snap, assignment_id=ASSIGNMENT,
+                            observation=observation, proposal=proposal)
+        self.assertIsInstance(result, int)
+        saved = registry.state[ResidentReasoner.STATE_KEY]
+        self.assertEqual(set(saved["plans"]), set(final_state[ResidentReasoner.STATE_KEY]["plans"]))
+        self.assertEqual(saved["outcomes"], final_state[ResidentReasoner.STATE_KEY]["outcomes"])
+        self.assertEqual(registry.writes, 1)
+
+    def test_exact_request_replay_persists_current_plan_without_changing_prior_plan_keys(self):
+        from dataclasses import asdict
+        other = {"objective:other": asdict(PlanProposal("other",
+            (PlanStep("old", "old", ("other criterion",)),), 1))}
+        initial = {"resident_reasoning_v1": {"plans": other, "outcomes": []}}
+        registry = FakeRegistry(initial)
+        provider = Provider()
+        r = reasoner(registry, provider)
+        first = r.propose(ASSIGNMENT, trigger="persistent_resident_cycle", token_budget=100)
+        self.assertEqual(first.status, ReasoningStatus.PROPOSED)
+        first_request_id = first.request_id
+        before_keys = set(registry.state["resident_reasoning_v1"]["plans"])
+        second = r.propose(ASSIGNMENT, trigger="persistent_resident_cycle", token_budget=100)
+        self.assertEqual(second.status, ReasoningStatus.PROPOSED)
+        self.assertEqual(second.request_id, first_request_id)
+        self.assertEqual(set(registry.state["resident_reasoning_v1"]["plans"]), before_keys)
+        self.assertEqual(registry.state["resident_reasoning_v1"]["plans"][ASSIGNMENT]["summary"], "plan 2")
+        self.assertEqual(registry.writes, 2)
+
+    def test_compact_overflow_fails_closed_preserving_current_and_other_plans(self):
+        from dataclasses import asdict
+        plans = {
+            ASSIGNMENT: asdict(PlanProposal("keep current", (PlanStep("a", "a", ("c",)),), 1)),
+            "objective:other": asdict(PlanProposal("keep other", (PlanStep("b", "b", ("d",)),), 1)),
+        }
+        outcomes = [{"assignment_id": "objective:history", "marker": "history-preserve"}]
+        initial = {"resident_reasoning_v1": {"plans": plans, "outcomes": outcomes},
+                   "other_office_state": {"payload": "x" * 66000}}
+        registry = FakeRegistry(initial)
+        provider = Provider()
+        r = reasoner(registry, provider)
+        with self.assertLogs("riverview_core.resident_reasoning", level="WARNING") as captured:
+            result = r.propose(ASSIGNMENT, trigger="persistent_resident_cycle", token_budget=100)
+        self.assertEqual(result.status, ReasoningStatus.STATE_CONFLICT)
+        self.assertEqual(result.detail_code, "DURABLE_STATE_WRITE_FAILED")
+        self.assertEqual(registry.writes, 0)
+        self.assertEqual(set(registry.state["resident_reasoning_v1"]["plans"]), set(plans))
+        self.assertEqual(registry.state["resident_reasoning_v1"]["outcomes"], outcomes)
+        text = "\n".join(captured.output)
+        self.assertIn("compact_state_bytes", text)
+        self.assertIn("prior_spaced_state_bytes", text)
+        self.assertNotIn("keep current", text)
+        self.assertNotIn("keep other", text)
+
+
