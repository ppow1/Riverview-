+# RIVERVIEW~ CONTROLLED TEST
+# File: tests/test_grace_reasoning_persistence_fence.py
+# Revision: 1.0.1 | 2026-10-29
+"""Offline append-only regression for terminal office-state failure fences."""
+from __future__ import annotations
+
+import json
+import unittest
+from contextlib import contextmanager
+from types import SimpleNamespace
+
+from riverview_core.resident_execution.service import GraceExecutionService
+from riverview_core.resident_reasoning import ReasoningStatus, ResidentReasoner
+
+OBJECTIVE = "objective:delivery-size-failure:test"
+PROVIDER_REQUEST_ID = "same-provider-request-replayed"
+RUNTIME_REVISION = "runtime-test-rev"
+
+
+class MemoryDB:
+    def __init__(self): self.events = {}
+    @contextmanager
+    def transaction(self): yield
+    @contextmanager
+    def cursor(self): yield MemoryCursor(self)
+
+
+class MemoryCursor:
+    def __init__(self, db): self.db = db; self.row = None
+    def execute(self, query, params):
+        if "INSERT INTO grace_objective_events" in query:
+            objective_id, key, payload = params
+            event_type = ("execution.reasoning_attempted" if "reasoning_attempted" in query
+                          else "execution.reasoning_failed")
+            self.db.events.setdefault(key, {"objective_id": objective_id,
+                "event_type": event_type, "payload": json.loads(payload)})
+        elif "SELECT count(*) AS failures" in query:
+            objective_id, runtime_revision, _ = params
+            count = sum(1 for row in self.db.events.values()
+                if row["objective_id"] == objective_id
+                and row["event_type"] == "execution.reasoning_failed"
+                and row["payload"].get("runtime_revision") == runtime_revision)
+            self.row = {"failures": count}
+        elif "SELECT 1 FROM grace_objective_events" in query:
+            objective_id, codes, revision, _ = params
+            blocked = any(row["objective_id"] == objective_id
+                and row["event_type"] == "execution.reasoning_failed"
+                and row["payload"].get("detail_code") in codes
+                and row["payload"].get("status") == "BLOCKED"
+                and str(row["payload"].get("objective_revision")) == revision
+                for row in self.db.events.values())
+            self.row = {"blocked": 1} if blocked else None
+        else:
+            raise AssertionError("unexpected SQL in isolated test")
+    def fetchone(self): return self.row
+
+
+class PersistenceFenceTest(unittest.TestCase):
+    def test_legacy_unblocked_request_failure_does_not_block_append_only_terminal_fence(self):
+        db = MemoryDB()
+        legacy_key = f"grace-reasoning-failure:{OBJECTIVE}:{PROVIDER_REQUEST_ID}"
+        legacy_payload = {"status": "STATE_CONFLICT", "detail_code": "DURABLE_STATE_WRITE_FAILED",
+                          "runtime_revision": RUNTIME_REVISION}
+        db.events[legacy_key] = {"objective_id": OBJECTIVE,
+            "event_type": "execution.reasoning_failed", "payload": dict(legacy_payload)}
+
+        class Pipeline:
+            ledger = SimpleNamespace(db=db, _set_search_path=lambda _cur: None)
+            def grounded_objectives(self, **_kwargs):
+                return [{"objective_id": OBJECTIVE, "revision": 2}]
+
+        class Reasoner:
+            office_id = "office:grace-test"
+            providers = {"provider.test": object()}
+            def __init__(self): self.calls = 0
+            def propose(self, *_args, **_kwargs):
+                self.calls += 1
+                return ResidentReasoner._result_after_record(None, ReasoningStatus.PROPOSED,
+                    PROVIDER_REQUEST_ID, "PROPOSAL_ONLY", "provider.test")
+
+        def service_with(reasoner):
+            service = object.__new__(GraceExecutionService)
+            service.pipeline = Pipeline(); service.resident_reasoner = reasoner
+            service.authority_ref = "work-order:engineering"; service.resident_token_budget = 128
+            service.external_reasoning_exchange = None
+            service._runtime_revision = lambda: RUNTIME_REVISION
+            service._record_experiment_outcome = lambda *_a, **_k: None
+            service._claim_autonomous_local_recovery = lambda *_a: None
+            service._claim_approved_recovery = lambda *_a: None
+            service._claim_experiment_recovery = lambda *_a: None
+            return service
+
+        failure = ResidentReasoner._result_after_record(None, ReasoningStatus.PROPOSED,
+            PROVIDER_REQUEST_ID, "PROPOSAL_ONLY", "provider.test")
+        self.assertEqual(failure.detail_code, "DURABLE_STATE_WRITE_FAILED")
+        first_reasoner = Reasoner(); first = service_with(first_reasoner)
+        self.assertFalse(first.reason_one_grounded_objective())
+
+        failed = [row for row in db.events.values()
+            if row["event_type"] == "execution.reasoning_failed"]
+        attempts = [row for row in db.events.values()
+            if row["event_type"] == "execution.reasoning_attempted"]
+        self.assertEqual(len(failed), 2)
+        self.assertEqual(db.events[legacy_key]["payload"], legacy_payload)
+        fence_key = f"grace-reasoning-failure-fence:{OBJECTIVE}:r2:DURABLE_STATE_WRITE_FAILED"
+        self.assertIn(fence_key, db.events)
+        self.assertNotEqual(fence_key, legacy_key)
+        self.assertEqual(db.events[fence_key]["payload"]["status"], "BLOCKED")
+        self.assertEqual(db.events[fence_key]["payload"]["objective_revision"], 2)
+        self.assertEqual(len(attempts), 1)
+
+        # Replaying fence persistence is append-only/idempotent under its separate key.
+        first._record_reasoning_failure(OBJECTIVE, result=failure, blocked_revision=2)
+        self.assertEqual(len([row for row in db.events.values()
+            if row["event_type"] == "execution.reasoning_failed"]), 2)
+
+        # A reconstructed service observes the durable BLOCKED row and does not call reasoning.
+        restarted_reasoner = Reasoner(); restarted = service_with(restarted_reasoner)
+        self.assertFalse(restarted.reason_one_grounded_objective())
+        self.assertEqual(restarted_reasoner.calls, 0)
+        self.assertEqual(len([row for row in db.events.values()
+            if row["event_type"] == "execution.reasoning_attempted"]), 1)
+
+
+if __name__ == "__main__": unittest.main()
