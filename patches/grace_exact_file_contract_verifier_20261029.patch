+    def test_exact_utf8_file_contract_is_bound_to_one_persisted_artifact_path(self):
+        from hashlib import sha256
+
+        objective_id = "objective:exact-file-contract"
+        clauses = [
+            "File exists at reports/grace_delivery_20261029.txt",
+            "File contains exactly GRACE-DELIVERY-20261029 with no extra content, whitespace, or line breaks",
+            "File encoding is UTF-8",
+        ]
+        invocation = 0
+
+        def verify(requirement_specs, bodies, step_criteria):
+            nonlocal invocation
+            invocation += 1
+            assignment_id = f"assignment:exact-file-contract:{invocation}"
+            requirements = [{"name": name, "path": path, "media_type": "text/plain",
+                "acceptance_criteria": list(criteria), "max_bytes": 32768}
+                for name, path, criteria in requirement_specs]
+            class Pipeline:
+                def proposal_step_for_assignment(_self, requested_objective, requested_assignment):
+                    self.assertEqual(requested_objective, objective_id)
+                    self.assertEqual(requested_assignment, assignment_id)
+                    return {"acceptance_criteria": list(step_criteria),
+                            "artifact_requirements": requirements}
+
+            assignment_hash = sha256(assignment_id.encode()).hexdigest()
+            directory = self.artifacts / f"codex-{assignment_hash}"
+            directory.mkdir(mode=0o700)
+            entries = []
+            first_path = None
+            for requirement, raw in zip(requirements, bodies):
+                name_hash = sha256(requirement["name"].encode()).hexdigest()[:12]
+                artifact_path = directory / name_hash
+                artifact_path.write_bytes(raw)
+                artifact_path.chmod(0o600)
+                entries.append({"name": requirement["name"], "path": requirement["path"],
+                    "media_type": requirement["media_type"],
+                    "acceptance_criteria": requirement["acceptance_criteria"],
+                    "storage_name": f"codex-{assignment_hash}/{name_hash}",
+                    "sha256": sha256(raw).hexdigest(), "bytes": len(raw)})
+                if first_path is None:
+                    first_path = artifact_path
+            first = entries[0]
+            result = {"status": "SUCCEEDED", "artifact_schema": "rv.codex-cli.artifacts.v3",
+                "assignment_id": assignment_id, "objective_id": objective_id,
+                "artifact_name": first["storage_name"], "artifact_path": str(first_path),
+                "artifact_sha256": first["sha256"], "artifact_bytes": first["bytes"],
+                "source_artifact_name": first["path"],
+                "changed_files": sorted(item["path"] for item in requirements),
+                "source_revision": "a" * 40, "source_sha256": "b" * 64,
+                "repository_revision": "c" * 40, "artifact_contract": requirements,
+                "artifacts": entries}
+            verifier = CodexArtifactVerifier(self.artifacts, Pipeline())
+            return verifier.verify({"id": assignment_id, "objective_ref": objective_id},
+                {"status": "succeeded", "capability": CAPABILITY,
+                 "attempt_id": f"attempt:{invocation}"}, result)
+
+        target = "reports/grace_delivery_20261029.txt"
+        accepted = verify([("delivery", target, clauses)],
+            [b"GRACE-DELIVERY-20261029"], clauses)
+        self.assertEqual(accepted.status.value, "ACCEPTED", dict(accepted.criteria))
+        self.assertTrue(accepted.criteria["all_required_step_criteria_supported"])
+        self.assertTrue(accepted.criteria["all_required_step_criteria_satisfied"])
+        self.assertTrue(accepted.criteria["all_artifact_acceptance_criteria_supported"])
+        self.assertTrue(accepted.criteria["explicit_artifact_acceptance_clauses_satisfied"])
+        self.assertEqual(CodexArtifactVerifier.REVISION, "1.0.6")
+
+        for body in (b"GRACE-DELIVERY-20261029\n", b" GRACE-DELIVERY-20261029",
