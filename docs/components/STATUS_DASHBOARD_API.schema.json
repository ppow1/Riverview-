{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riverview.invalid/contracts/dashboard/status-v1.2.schema.json",
  "title": "Riverview Status Dashboard API v1.2",
  "description": "Authenticated dashboard projections and bounded Steward operations, including private GitHub snapshot archival.",
  "$defs": {
    "timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "type": "object",
      "required": [
        "schema_version",
        "component_id",
        "component_version",
        "observed_at",
        "projection_status",
        "freshness",
        "source",
        "cme",
        "workers"
      ],
      "properties": {
        "schema_version": {
          "const": "rv.dashboard.status.v1"
        },
        "component_id": {
          "const": "STEWARD-DASHBOARD"
        },
        "component_version": {
          "type": "string"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "projection_status": {
          "enum": [
            "healthy",
            "not_initialized",
            "unavailable",
            "degraded"
          ]
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unknown",
            "unavailable"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "kind",
            "schema",
            "source_commit",
            "deployment_id"
          ],
          "properties": {
            "kind": {
              "const": "postgresql"
            },
            "database": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            },
            "source_commit": {
              "type": "string"
            },
            "deployment_id": {
              "type": "string"
            },
            "latest_migration": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": true
        },
        "event_cursor": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "assignment_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "assignments_total": {
          "type": "integer",
          "minimum": 0
        },
        "cme": {
          "type": "object"
        },
        "workers": {
          "$ref": "#/$defs/workers"
        },
        "verification": {
          "type": "object"
        },
        "relations": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "diagnostics": {
          "type": "object"
        },
        "unavailable_reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "not_initialized"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 100
        },
        "next_cursor": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "older_cursor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "newer_cursor": {
          "type": [
            "integer",
            "null"
          ]
        },
        "page_limit": {
          "type": "integer",
          "maximum": 100
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "objectiveProgressItem": {
      "type": "object",
      "required": [
        "objective_id",
        "status",
        "assignment_id",
        "assignment_state",
        "origin",
        "lifecycle_status",
        "lifecycle_stage",
        "steward_action_required",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "objective_id": {"type": "string"},
        "status": {"type": "string"},
        "assignment_id": {"type": ["string", "null"]},
        "assignment_state": {"type": ["string", "null"]},
        "origin": {
          "type": ["object", "null"],
          "properties": {
            "conversation_id": {"type": "string", "format": "uuid"},
            "source_sequence": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "lifecycle_status": {"type": "string"},
        "lifecycle_stage": {"type": "string"},
        "latest_event": {"type": ["object", "null"]},
        "verification": {"type": ["object", "null"]},
        "rework": {"type": "object"},
        "steward_action_required": {"type": "boolean"},
        "dispatch_failures": {"type": "integer", "minimum": 0},
        "last_dispatch_failure_at": {"$ref": "#/$defs/timestamp"},
        "verification_failures": {"type": "integer", "minimum": 0},
        "last_verification_failure_at": {"$ref": "#/$defs/timestamp"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "objectiveProgressPage": {
      "type": "object",
      "required": ["schema_version", "status", "items", "limit"],
      "properties": {
        "schema_version": {"const": "rv.dashboard.objective_progress.v1"},
        "status": {"enum": ["available", "not_initialized"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/objectiveProgressItem"}
        },
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "truncated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": [
        "schema_version",
        "captured_at",
        "observed_state",
        "source",
        "projection",
        "redaction"
      ],
      "properties": {
        "schema_version": {
          "const": "rv.dashboard.snapshot.v1"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_state": {
          "type": "boolean"
        },
        "source": {
          "type": "object"
        },
        "projection": {
          "$ref": "#/$defs/status"
        },
        "assignments": {
          "$ref": "#/$defs/page"
        },
        "events": {
          "$ref": "#/$defs/page"
        },
        "attention": {
          "type": "object"
        },
        "references": {
          "type": "object"
        },
        "redaction": {
          "type": "object"
        },
        "client_state": {
          "type": "object"
        },
        "workers": {
          "$ref": "#/$defs/workerPage"
        }
      },
      "additionalProperties": true
    },
    "workers": {
      "type": "object",
      "required": [
        "status",
        "active_workers",
        "healthy_workers",
        "stale_workers",
        "unknown_workers",
        "unverified_workers",
        "active_leases",
        "source"
      ],
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "stale",
            "unknown",
            "unverified",
            "not_initialized",
            "unavailable"
          ]
        },
        "active_workers": {
          "type": "integer",
          "minimum": 0
        },
        "healthy_workers": {
          "type": "integer",
          "minimum": 0
        },
        "stale_workers": {
          "type": "integer",
          "minimum": 0
        },
        "unknown_workers": {
          "type": "integer",
          "minimum": 0
        },
        "unverified_workers": {
          "type": "integer",
          "minimum": 0
        },
        "active_leases": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "const": "assignment_leases"
        },
        "health_semantics": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "workerPage": {
      "type": "object",
      "required": [
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "not_initialized"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "worker_id",
              "active",
              "status",
              "last_heartbeat_at",
              "heartbeat_age_seconds",
              "active_leases",
              "source"
            ],
            "properties": {
              "worker_id": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              },
              "status": {
                "enum": [
                  "healthy",
                  "stale",
                  "unknown",
                  "unverified",
                  "inactive"
                ]
              },
              "last_heartbeat_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              },
              "heartbeat_age_seconds": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "active_leases": {
                "type": "integer",
                "minimum": 0
              },
              "source": {
                "const": "assignment_leases"
              }
            },
            "additionalProperties": false
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_limit": {
          "type": "integer",
          "maximum": 100
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "graphIndex": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "items"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "graph_id",
              "component_id",
              "workflow_id",
              "graph_revision",
              "node_count",
              "edge_count"
            ],
            "properties": {
              "graph_id": {
                "type": "string"
              },
              "component_id": {
                "type": "string"
              },
              "workflow_id": {
                "type": "string"
              },
              "graph_revision": {
                "type": "string"
              },
              "node_count": {
                "type": "integer",
                "minimum": 1
              },
              "edge_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "schema_version": {
          "const": "rv.dashboard.graph-index.v1"
        }
      },
      "additionalProperties": false
    },
    "graphResponse": {
      "type": "object",
      "required": [
        "schema_version",
        "status",
        "graph"
      ],
      "properties": {
        "status": {
          "const": "available"
        },
        "graph": {
          "type": "object",
          "required": [
            "graph_id",
            "graph_revision",
            "component_id",
            "workflow_id",
            "nodes",
            "edges",
            "execution_position"
          ],
          "properties": {
            "graph_id": {
              "type": "string"
            },
            "graph_revision": {
              "type": "string"
            },
            "component_id": {
              "type": "string"
            },
            "workflow_id": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "execution_position": {
              "type": "object",
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "unknown",
                    "unavailable",
                    "current"
                  ]
                },
                "reason": {
                  "type": "string"
                },
                "assignment_id": {
                  "type": "string"
                },
                "node_id": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": true
        },
        "schema_version": {
          "const": "rv.dashboard.graph.v1"
        }
      },
      "additionalProperties": false
    },
    "snapshotArchiveResult": {
      "type": "object",
      "required": ["status", "snapshot_id", "release_url", "asset_name", "archive_sha256", "archive_size_bytes", "retention"],
      "properties": {
        "status": {"const": "archived"},
        "snapshot_id": {"type": "string", "pattern": "^rvdiag-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}$"},
        "release_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/[^/]+/[^/]+/releases/tag/rvdiag-"},
        "asset_name": {"type": "string", "pattern": "^rvdiag-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{32}\\.zip$"},
        "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "archive_size_bytes": {"type": "integer", "minimum": 1, "maximum": 101711872},
        "retention": {"const": "permanent"}
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/status"
    },
    {
      "$ref": "#/$defs/page"
    },
    {
      "$ref": "#/$defs/objectiveProgressPage"
    },
    {
      "$ref": "#/$defs/workerPage"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/graphIndex"
    },
    {
      "$ref": "#/$defs/graphResponse"
    },
    {
      "$ref": "#/$defs/snapshotArchiveResult"
    }
  ]
}
