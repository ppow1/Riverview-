{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverview:notification-delivery:api:1.0.0",
  "title": "Riverview visual notification API",
  "oneOf": [
    {"$ref":"#/$defs/page"},
    {"$ref":"#/$defs/receipt"}
  ],
  "$defs": {
    "page": {
      "type":"object",
      "required":["schema_version","status","observed_at","limit","dispatcher","items"],
      "properties":{
        "schema_version":{"const":"rv.notifications.v1"},
        "status":{"enum":["available","not_initialized"]},
        "observed_at":{"type":["string","null"],"format":"date-time"},
        "limit":{"type":"integer","minimum":1,"maximum":50},
        "dispatcher":{"type":"object"},
        "items":{"type":"array","maxItems":50,"items":{"$ref":"#/$defs/item"}}
      },
      "additionalProperties":false
    },
    "item": {
      "type":"object",
      "required":["notification_id","source_event_id","assignment_id","event_type","channel","source_recorded_at","created_at","delivered_at","acknowledged_at","request_id","decision_status","assignment_version","delivery_status","decision_request_id","recovery_request_id","recovery_status","recovery_objective_id","recovery_objective_revision","recovery_action","attempt_limit","recovery_expires_at","summary","source_details"],
      "properties":{
        "notification_id":{"type":"string","format":"uuid"},
        "source_event_id":{"type":"string","format":"uuid"},
        "assignment_id":{"type":["string","null"]},
        "event_type":{"enum":["assignment_stalled","deadline_missed","assignment_attention","recovery_requested","monitor_failed","attention_resolved","grace_objective_blocked"]},
        "channel":{"const":"dashboard.visual.v1"},
        "source_recorded_at":{"type":"string","format":"date-time"},
        "created_at":{"type":"string","format":"date-time"},
        "delivered_at":{"type":["string","null"],"format":"date-time"},
        "acknowledged_at":{"type":["string","null"],"format":"date-time"},
        "request_id":{"type":["string","null"],"format":"uuid"},
        "decision_request_id":{"type":["string","null"],"format":"uuid"},
        "recovery_request_id":{"type":["string","null"],"format":"uuid"},
        "recovery_status":{"type":["string","null"],"enum":["pending","approved","deferred","rejected","expired","dispatched","consumed",null]},
        "recovery_objective_id":{"type":["string","null"],"maxLength":160},
        "recovery_objective_revision":{"type":["integer","null"],"minimum":1},
        "recovery_action":{"type":["string","null"],"enum":["retry_reasoning_once",null]},
        "attempt_limit":{"type":["integer","null"],"enum":[1,null]},
        "recovery_expires_at":{"type":["string","null"],"format":"date-time"},
        "decision_status":{"type":["string","null"],"enum":["pending",null]},
        "assignment_version":{"type":["integer","null"],"minimum":1},
        "delivery_status":{"enum":["queued","delivered","acknowledged"]},
        "summary":{"type":"string","maxLength":160},
        "source_details":{"oneOf":[{"type":"null"},{"type":"object","required":["objective_id","objective_revision","runtime_revision","failure_count","last_error_code","blocked_at","last_failure_at","decision","recommended_action","automatic_recovery"],"properties":{"objective_id":{"type":"string","maxLength":160},"objective_revision":{"type":"integer","minimum":1},"runtime_revision":{"type":"string","maxLength":64},"failure_count":{"type":"integer","minimum":0},"last_error_code":{"type":"string","maxLength":80},"blocked_at":{"type":"string","format":"date-time"},"last_failure_at":{"type":["string","null"],"format":"date-time"},"decision":{"const":"escalate_to_steward"},"recommended_action":{"type":"string","maxLength":120},"automatic_recovery":{"const":false}},"additionalProperties":false}]}
      },
      "additionalProperties":false
    },
    "receipt": {
      "type":"object",
      "required":["schema_version","status","notification_id","recorded_at","already_recorded","decision_request_status","authority_effect"],
      "properties":{
        "schema_version":{"const":"rv.notification_receipt.v1"},
        "status":{"enum":["delivered","acknowledged"]},
        "notification_id":{"type":"string","format":"uuid"},
        "recorded_at":{"type":["string","null"],"format":"date-time"},
        "already_recorded":{"type":"boolean"},
        "decision_request_status":{"type":["string","null"],"enum":["pending",null]},
        "authority_effect":{"const":"none"}
      },
      "additionalProperties":false
    }
  }
}
