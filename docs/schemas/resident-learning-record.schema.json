{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:riverview:resident-learning-record:v1",
  "title": "Riverview resident learning record envelope",
  "description": "Non-authorizing proposal/record shape. Validation of authority and evidence requires the existing institutional services.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "revision",
    "originating_resident_id",
    "scope_ref",
    "classification",
    "retention",
    "status",
    "content",
    "content_sha256",
    "evidence",
    "provenance",
    "created_at"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^learning:[0-9a-f-]{36}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "originating_resident_id": {
      "type": "string",
      "pattern": "^resident:[A-Za-z0-9._:-]{1,220}$"
    },
    "scope_ref": {
      "type": "string",
      "pattern": "^(resident:[A-Za-z0-9._:-]{1,220}|institution:riverview)$"
    },
    "classification": {
      "enum": [
        "internal",
        "confidential",
        "restricted",
        "local_only"
      ]
    },
    "retention": {
      "enum": [
        "request_only",
        "conversation_policy",
        "bounded_durable"
      ]
    },
    "status": {
      "enum": [
        "candidate",
        "validated",
        "approved",
        "rejected",
        "superseded",
        "withdrawn"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "source_kind",
          "captured_at"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "source_kind": {
            "enum": [
              "resident_statement",
              "conversation_event",
              "repository_source",
              "operational_observation",
              "external_source"
            ]
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "source_revision": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 256
          },
          "source_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "recorder_id",
        "method",
        "interpretation"
      ],
      "properties": {
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorder_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "implementation_revision": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        },
        "interpretation": {
          "enum": [
            "direct_observation",
            "resident_assertion",
            "imported_source",
            "model_interpretation"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "validator_id",
        "validated_at",
        "evidence_refs",
        "authority_event_ref"
      ],
      "properties": {
        "result": {
          "enum": [
            "SUPPORTED",
            "CONTRADICTED",
            "INSUFFICIENT"
          ]
        },
        "validator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "validated_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 50
        },
        "authority_event_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "actor_id",
        "decided_at",
        "scope_ref",
        "purpose",
        "content_sha256",
        "authority_event_ref",
        "reason"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "STEWARD_APPROVE",
            "RESIDENT_CONFIRM",
            "OWNER_VALIDATE",
            "REJECT",
            "WITHDRAW"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "scope_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "authority_event_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "supersedes": {
      "type": "string",
      "pattern": "^learning:[0-9a-f-]{36}$"
    },
    "supersession_event_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope_ref": {
            "const": "institution:riverview"
          }
        },
        "required": [
          "scope_ref"
        ]
      },
      "then": {
        "properties": {
          "classification": {
            "enum": [
              "internal",
              "confidential",
              "restricted"
            ]
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "properties": {
              "scope_ref": {
                "const": "institution:riverview"
              }
            },
            "required": [
              "scope_ref"
            ]
          },
          {
            "properties": {
              "status": {
                "const": "approved"
              }
            },
            "required": [
              "status"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "retention": {
            "const": "bounded_durable"
          },
          "decision": {
            "required": [
              "outcome"
            ],
            "properties": {
              "outcome": {
                "const": "STEWARD_APPROVE"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validation",
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "enum": [
                  "STEWARD_APPROVE",
                  "RESIDENT_CONFIRM",
                  "OWNER_VALIDATE"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "validated"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validation"
        ],
        "properties": {
          "validation": {
            "properties": {
              "result": {
                "const": "SUPPORTED"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "const": "REJECT"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "withdrawn"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "properties": {
              "outcome": {
                "const": "WITHDRAW"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "superseded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "supersedes",
          "supersession_event_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "retention": {
            "const": "request_only"
          }
        },
        "required": [
          "retention"
        ]
      },
      "then": {
        "properties": {
          "scope_ref": {
            "pattern": "^resident:"
          }
        }
      }
    }
  ]
}
