  "upgrade": {
    "jsonrpc": "2.0",
    "id": "grant-change-upgrade",
    "method": "tools/call",
    "params": {
      "name": "comms5_request_delegation_grant_change",
      "arguments": {
        "grant_id": "grant:example",
        "action": "comms5.operations.non_destructive.v1",
        "scope_ref": "project:Riverview",
        "policy_ref": "policy:delegation.v1",
        "change_kind": "upgrade",
        "request_ref": "upgrade exact proposal permission to the reviewed broad non-destructive set",
        "idempotency_key": "example-upgrade"
      }
    },
    "precondition": "The predecessor is active, uses no count limit, and has an absolute expiry; this request preserves both lifetime fields."
  },
  "extend_and_upgrade": {
    "jsonrpc": "2.0",
    "id": "grant-change-combined",
    "method": "tools/call",
    "params": {
      "name": "comms5_request_delegation_grant_change",
      "arguments": {
        "grant_id": "grant:example",
        "action": "comms5.operations.non_destructive.v1",
        "scope_ref": "project:Riverview",
        "policy_ref": "policy:delegation.v1",
        "change_kind": "extend_upgrade",
        "duration_spec": {
          "unit": "months",
          "value": 1
        },
        "request_ref": "extend and add exact promotion permission",
        "idempotency_key": "example-combined-change",
        "max_uses": null
      }
    },
    "precondition": "The predecessor is an exact proposal-promotion grant with a finite use limit and expiry. One approval replaces it with the broad non-destructive permission and extends its lifetime."
  },
  "revoke": {
    "path": "/api/v1/steward/delegated-grants/grant:example/revoke",
    "method": "POST",
    "body": {
      "confirm": true,
      "reason_code": "steward_revoked"
    }
  },
