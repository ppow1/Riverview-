# Riverview Controlled Source
# File: deploy/comms5/caddy-comms5-oauth-block.caddy
# Component: COMMS5-OAUTH-IONOGE
# Revision: 1.0.0
# History: New configuration fragment; no predecessor existed.
# Insert inside the existing riverview-comms.ionoge.com site block. Keep the
# existing Comms4 /mcp handler unchanged and retain the static Comms5 bearer
# branch before this OAuth forward-auth fallback.

@comms5_oauth_authorize path /oauth/authorize
handle @comms5_oauth_authorize {
	reverse_proxy 127.0.0.1:11827 {
		header_up X-Riverview-OAuth-Proxy-Key {env.RIVERVIEW_COMMS5_OAUTH_PROXY_KEY}
	}
}

@comms5_oauth_public path /.well-known/oauth-protected-resource /.well-known/oauth-authorization-server /oauth/register /oauth/token /oauth/revoke
handle @comms5_oauth_public {
	reverse_proxy 127.0.0.1:11827
}

@riverview_comms5_mcp {
	path /comms5/mcp
	method GET POST OPTIONS DELETE
}
handle @riverview_comms5_mcp {
	@riverview_comms5_authenticated header Authorization "Bearer {env.RIVERVIEW_COMMS5_CLIENT_SECRET}"
	handle @riverview_comms5_authenticated {
		uri replace /comms5/mcp /mcp
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:11826 {
			header_up Authorization "Bearer {env.RIVERVIEW_COMMS5_UPSTREAM_AUTH}"
			header_up X-Riverview-Comms5 1
			header_up X-Riverview-Comms5-Principal steward
			header_up Host 127.0.0.1:11826
			transport http {
				read_timeout 20s
				write_timeout 20s
			}
		}
	}
	handle {
		forward_auth 127.0.0.1:11827 {
			uri /oauth/verify
		}
		uri replace /comms5/mcp /mcp
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:11826 {
			header_up Authorization "Bearer {env.RIVERVIEW_COMMS5_UPSTREAM_AUTH}"
			header_up -X-Riverview-Comms5
			header_up -X-Riverview-Comms5-Principal
			header_up X-Riverview-Comms5 1
			header_up X-Riverview-Comms5-Principal steward
			header_up Host 127.0.0.1:11826
			transport http {
				read_timeout 20s
				write_timeout 20s
			}
		}
	}
}
